{
  "name": "@mariczne/pi-power-user",
  "version": "0.17.2",
  "description": "Power-user toolkit extension for pi coding agent",
  "type": "module",
  "files": [
    "*.ts",
    "*.md",
    "*.json",
    "!progress.md",
    "bash-mode/**/*.ts",
    "sub-usages/**/*.ts"
  ],
  "keywords": [
    "pi-package",
    "pi",
    "coding-agent",
    "powerline",
    "status-bar",
    "power-user",
    "editor",
    "shortcut-palette",
    "bash-mode",
    "extension"
  ],
  "author": "Nico Bailon",
  "contributors": [
    "mariczne"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mariczne/pi-power-user.git"
  },
  "bugs": {
    "url": "https://github.com/mariczne/pi-power-user/issues"
  },
  "homepage": "https://github.com/mariczne/pi-power-user#readme",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test tests/**/*.test.ts"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": ">=0.81.0",
    "@earendil-works/pi-coding-agent": ">=0.81.0",
    "@earendil-works/pi-tui": ">=0.81.0"
  },
  "devDependencies": {
    "@earendil-works/pi-ai": "1.1.0",
    "@earendil-works/pi-coding-agent": "1.1.0",
    "@earendil-works/pi-tui": "1.1.0",
    "@types/node": "24.13.3",
    "typescript": "5.9.3"
  },
  "pi": {
    "extensions": [
      "./index.ts"
    ]
  }
}
